<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/surfaceBackground"
    android:fillViewport="true" android:fitsSystemWindows="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_horizontal"
        android:orientation="vertical" android:paddingStart="16dp" android:paddingTop="24dp"
        android:paddingEnd="16dp" android:paddingBottom="24dp">

        <ImageView android:id="@+id/imageView2" android:layout_width="220dp" android:layout_height="72dp"
            android:contentDescription="@string/app_name" android:scaleType="centerInside" app:srcCompat="@drawable/logo_breit_unten" />

        <com.google.android.material.card.MaterialCardView style="@style/Widget.SKIBin.Card" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="18dp" app:cardCornerRadius="25dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_horizontal"
                android:orientation="vertical" android:padding="22dp">
                <ImageView android:id="@+id/imageView" android:layout_width="86dp" android:layout_height="86dp"
                    android:background="@drawable/bg_login_biometric" android:contentDescription="@string/fingerprintAuthenticateTitle"
                    android:padding="20dp" app:srcCompat="@drawable/ic_baseline_fingerprint_24" app:tint="@color/white" />

                <LinearLayout android:id="@+id/loginMode" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center_horizontal" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp"
                        android:gravity="center" android:text="@string/loginWelcome" android:textColor="@color/black" android:textSize="23sp" android:textStyle="bold" />
                    <TextView android:id="@+id/loginDescription" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" android:gravity="center" android:lineSpacingExtra="3dp"
                        android:text="@string/loginDescription" android:textColor="@color/grey" android:textSize="15sp" />
                    <TextView android:id="@+id/authenticationStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:accessibilityLiveRegion="polite" android:gravity="center" android:minHeight="32dp" android:paddingTop="8dp"
                        android:textColor="@color/buttonDanger" android:textSize="13sp" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/authenticate" style="@style/Widget.SKIBin.Button.Primary"
                        android:layout_width="match_parent" android:layout_height="56dp" android:text="@string/loginBiometric"
                        app:icon="@drawable/ic_baseline_fingerprint_24" app:iconGravity="textStart" />
                    <TextView android:id="@+id/loginDivider" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginVertical="14dp" android:gravity="center" android:text="@string/loginOrPin"
                        android:textColor="@color/grey" android:textSize="11sp" android:textStyle="bold" />
                    <com.google.android.material.textfield.TextInputLayout android:id="@+id/pinInputLayout"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:hint="@string/loginPin" app:boxCornerRadiusBottomEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp" app:boxCornerRadiusTopEnd="14dp" app:boxCornerRadiusTopStart="14dp"
                        app:endIconMode="password_toggle">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/pinNumber" android:layout_width="match_parent"
                            android:layout_height="58dp" android:importantForAutofill="no" android:inputType="numberPassword" android:maxLength="8" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.button.MaterialButton android:id="@+id/pinAuthenticateBtn" style="@style/Widget.SKIBin.Button.Secondary"
                        android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="10dp" android:text="@string/loginWithPin" />
                </LinearLayout>

                <LinearLayout android:id="@+id/pinResetMode" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center_horizontal" android:orientation="vertical" android:visibility="gone">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp"
                        android:gravity="center" android:text="@string/loginSetPinTitle" android:textColor="@color/black" android:textSize="23sp" android:textStyle="bold" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
                        android:gravity="center" android:text="@string/loginSetPinDescription" android:textColor="@color/grey" android:textSize="14sp" />
                    <com.google.android.material.textfield.TextInputLayout style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp"
                        android:hint="@string/loginNewPin" app:endIconMode="password_toggle">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/pinNewNumber" android:layout_width="match_parent"
                            android:layout_height="58dp" android:importantForAutofill="no" android:inputType="numberPassword" android:maxLength="8" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"
                        android:hint="@string/loginConfirmPin" app:endIconMode="password_toggle">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/pinNumberVerify" android:layout_width="match_parent"
                            android:layout_height="58dp" android:importantForAutofill="no" android:inputType="numberPassword" android:maxLength="8" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <TextView android:id="@+id/pinResetHelp" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:accessibilityLiveRegion="polite" android:paddingVertical="8dp" android:text="@string/loginPinHelp" android:textColor="@color/grey" android:textSize="12sp" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/pinAuthenticateBtnNew" style="@style/Widget.SKIBin.Button.Primary"
                        android:layout_width="match_parent" android:layout_height="56dp" android:text="@string/loginSavePin" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/cancelPinReset" style="@style/Widget.SKIBin.Button.Secondary"
                        android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="10dp" android:text="@string/detailCancel" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout android:id="@+id/loginSecondaryActions" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center" android:orientation="horizontal" android:paddingTop="8dp">
            <com.google.android.material.button.MaterialButton android:id="@+id/pinsetNewBtn" style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content" android:layout_height="48dp" android:text="@string/loginResetPin" android:textColor="@color/colorPrimary" />
            <com.google.android.material.button.MaterialButton android:id="@+id/pinresetAll" style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content" android:layout_height="48dp" android:text="@string/loginResetApp" android:textColor="@color/buttonDanger" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center"
            android:text="@string/loginSecurityNote" android:textColor="@color/grey" android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
