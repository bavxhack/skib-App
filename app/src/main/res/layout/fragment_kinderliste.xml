<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/surfaceBackground" android:orientation="vertical"
    android:paddingStart="16dp" android:paddingTop="12dp" android:paddingEnd="16dp">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Kinder" android:textColor="@color/black" android:textSize="26sp" android:textStyle="bold" />

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp"
        android:hint="Name suchen …" app:boxBackgroundColor="@color/surfaceCard" app:boxCornerRadiusBottomEnd="16dp"
        app:boxCornerRadiusBottomStart="16dp" app:boxCornerRadiusTopEnd="16dp" app:boxCornerRadiusTopStart="16dp"
        app:boxStrokeColor="@color/strokeSubtle" app:startIconDrawable="@android:drawable/ic_menu_search">
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/childSearch"
            android:layout_width="match_parent" android:layout_height="50dp" android:inputType="textPersonName"
            android:maxLines="1" android:textSize="16sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:scrollbars="none" android:paddingTop="10dp" android:paddingBottom="8dp">
        <com.google.android.material.chip.ChipGroup android:id="@+id/childStatusFilters"
            android:layout_width="wrap_content" android:layout_height="wrap_content" app:selectionRequired="true"
            app:singleSelection="true" app:chipSpacingHorizontal="8dp">
            <com.google.android.material.chip.Chip android:id="@+id/filterAll" style="@style/Widget.MaterialComponents.Chip.Filter" android:layout_width="wrap_content" android:layout_height="48dp" android:checked="true" android:text="Alle" />
            <com.google.android.material.chip.Chip android:id="@+id/filterWaiting" style="@style/Widget.MaterialComponents.Chip.Filter" android:layout_width="wrap_content" android:layout_height="48dp" android:text="Nicht da" />
            <com.google.android.material.chip.Chip android:id="@+id/filterPresent" style="@style/Widget.MaterialComponents.Chip.Filter" android:layout_width="wrap_content" android:layout_height="48dp" android:text="Anwesend" />
            <com.google.android.material.chip.Chip android:id="@+id/filterSick" style="@style/Widget.MaterialComponents.Chip.Filter" android:layout_width="wrap_content" android:layout_height="48dp" android:text="Krank" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/url" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:textColor="@color/grey" android:textSize="12sp" android:textStyle="bold" />
        <com.jaredrummler.materialspinner.MaterialSpinner android:id="@+id/schulenChooseListe"
            android:layout_width="wrap_content" android:layout_height="48dp" android:minWidth="130dp" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerKinderListe"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:clipToPadding="false" android:paddingTop="4dp" android:paddingBottom="16dp" />
</LinearLayout>
